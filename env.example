# Get a key from https://aistudio.google.com/apikey
# Without it, CivicSync runs in demo mode (classification guessed from the note, clearly labelled).
GEMINI_API_KEY=

# Gemma 4 model served by the Gemini API: gemma-4-26b-a4b-it (faster) or gemma-4-31b-it (larger)
GEMMA_MODEL=gemma-4-26b-a4b-it

# Public URL, used for Open Graph links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional tuning
# GEMMA_THINKING=high          # let Gemma 4 think during photo analysis and fix checks (slower)
# TRANSLATE_CONCURRENCY=3      # parallel translation requests; lower if you hit rate limits
# TRANSLATE_MODEL=             # use a different model only for UI translation
